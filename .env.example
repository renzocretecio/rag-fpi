# Copy to .env and fill in the real values. Never commit the filled-in file.

# Postgres connection string (Neon).
# Use the DIRECT endpoint (no `-pooler` in the host) for the API and for the
# scripts: the app keeps one long-lived connection and relies on `SET
# search_path`, which a PgBouncer transaction-mode pool would drop.
# Neon always requires TLS: keep `?sslmode=require`.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# Needed only by scripts/migrate_data.py: the database you are copying FROM.
SOURCE_DATABASE_URL=

OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=all-minilm:l6-v2

HF_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GROQ_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

ALLOWED_ORIGINS=http://localhost:3000,https://creteciorenzo.vercel.app
